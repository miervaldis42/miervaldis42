{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Technology Statistics Definition",
  "type": "object",
  "required": ["$schema", "id", "title", "technologies"],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "../schemas/statistics-definition.schema.json"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "technologies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "metric"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "metric": {
            "type": "string",
            "enum": ["language", "adoption", "curated"]
          },
          "language": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "rule": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "icon": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "icons": {
            "type": "object",
            "required": ["light", "dark"],
            "properties": {
              "light": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "dark": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "additionalProperties": false
          }
        },
        "allOf": [
          {
            "oneOf": [
              {
                "properties": {
                  "metric": {
                    "const": "language"
                  }
                },
                "required": ["language"],
                "not": {
                  "anyOf": [
                    {
                      "required": ["rule"]
                    },
                    {
                      "required": ["label"]
                    }
                  ]
                }
              },
              {
                "properties": {
                  "metric": {
                    "const": "adoption"
                  }
                },
                "required": ["rule"],
                "not": {
                  "anyOf": [
                    {
                      "required": ["language"]
                    },
                    {
                      "required": ["label"]
                    }
                  ]
                }
              },
              {
                "properties": {
                  "metric": {
                    "const": "curated"
                  }
                },
                "required": ["label"],
                "not": {
                  "anyOf": [
                    {
                      "required": ["language"]
                    },
                    {
                      "required": ["rule"]
                    }
                  ]
                }
              }
            ]
          },
          {
            "oneOf": [
              {
                "required": ["icon"]
              },
              {
                "required": ["icons"]
              }
            ]
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
