{
  "biome": {
    "dependencies": {
      "exact": [
        "@biomejs/biome"
      ]
    },
    "configFiles": [
      "biome.json",
      "biome.jsonc"
    ]
  },
  "electron": {
    "dependencies": {
      "exact": [
        "electron"
      ]
    }
  },
  "husky": {
    "dependencies": {
      "exact": [
        "husky"
      ]
    },
    "packageJsonFields": [
      "husky"
    ]
  },
  "jest": {
    "dependencies": {
      "exact": [
        "jest",
        "@jest/core"
      ]
    },
    "configFiles": [
      "jest.config.js",
      "jest.config.cjs",
      "jest.config.mjs",
      "jest.config.ts",
      "jest.config.cts",
      "jest.config.mts"
