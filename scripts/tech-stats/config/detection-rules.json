      "jest"
    ]
  },
  "mongodb": {
    "dependencies": {
      "exact": [
        "mongodb",
        "mongoose"
      ]
    }
  },
  "nestjs": {
    "dependencies": {
      "exact": [
        "@nestjs/core"
      ]
    },
    "configFiles": [
      "nest-cli.json"
    ]
  },
  "nextjs": {
    "dependencies": {
      "exact": [
        "next"
      ]
    },
    "configFiles": [
